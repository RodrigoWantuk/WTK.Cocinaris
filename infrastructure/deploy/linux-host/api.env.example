# /etc/wtk-cocinaris/api.env — root:wtk-cocinaris 0640. Placeholders only; never commit real values.
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://127.0.0.1:8004
# The reverse proxy terminates TLS and forwards scheme and client address.
ASPNETCORE_FORWARDEDHEADERS_ENABLED=true
DOTNET_CLI_TELEMETRY_OPTOUT=1
COCINARIS_DB_CONNECTION=Host=127.0.0.1;Port=5432;Database=cocinaris;Username=cocinaris_app;Password=<generated>
# Any standards-compliant OIDC provider. Register the redirect URI
# https://<public-host>/signin-oidc and the sign-out callback https://<public-host>/signout-callback-oidc.
COCINARIS_OIDC_AUTHORITY=https://<oidc-provider>/<issuer-path>
COCINARIS_OIDC_CLIENT_ID=<client-id>
COCINARIS_OIDC_CLIENT_SECRET=<client-secret>
COCINARIS_SESSION_KEYRING_PATH=/var/lib/wtk-cocinaris/session-keys
