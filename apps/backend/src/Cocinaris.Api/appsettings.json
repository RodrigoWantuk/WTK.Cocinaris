{
  "ConnectionStrings": {
    "Cocinaris": ""
  },
  "Idempotency": {
    "Retention": "30.00:00:00"
  },
  "Session": {
    "CookieName": "__Host-cocinaris-session",
    "IdleTimeout": "08:00:00"
  },
  "Ai": {
    "Usage": {
      "GlobalDailyUnitCeiling": 5000,
      "UserDailyUnitCeiling": 200,
      "UserConcurrencyCeiling": 2,
      "MonthlyCostCeilingUsd": 5,
      "Disabled": false
    },
    "Providers": {
      "DeepSeek": {
        "Enabled": false,
        "BaseUrl": "https://api.deepseek.com",
        "ApiKey": "",
        "Model": "deepseek-v4-flash",
        "FallbackModel": "deepseek-chat",
        "ReasoningEffort": "high"
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
