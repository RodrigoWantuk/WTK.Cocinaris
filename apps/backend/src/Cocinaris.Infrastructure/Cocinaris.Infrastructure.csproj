<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>Cocinaris.Infrastructure</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <WarningsAsErrors>$(WarningsAsErrors);CS1591</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Cocinaris.Modules.Ai/Cocinaris.Modules.Ai.csproj" />
    <ProjectReference Include="../Cocinaris.Modules.Identity/Cocinaris.Modules.Identity.csproj" />
    <ProjectReference Include="../Cocinaris.Modules.Inventory/Cocinaris.Modules.Inventory.csproj" />
    <ProjectReference Include="../Cocinaris.Modules.Planning/Cocinaris.Modules.Planning.csproj" />
    <ProjectReference Include="../Cocinaris.Modules.Profiles/Cocinaris.Modules.Profiles.csproj" />
    <ProjectReference Include="../Cocinaris.Modules.Recipes/Cocinaris.Modules.Recipes.csproj" />
    <ProjectReference Include="../Cocinaris.SharedKernel/Cocinaris.SharedKernel.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <!-- WebP encoding of recipe images (PLAN-0030 follow-up). MIT; the NoDependencies native build needs no fontconfig. -->
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

</Project>
